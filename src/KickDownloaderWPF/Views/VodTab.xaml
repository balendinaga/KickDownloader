<UserControl x:Class="KickDownloaderWPF.Views.VodTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KickDownloaderWPF.Views"
             IsEnabled="{Binding NotBusy}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,24,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Download VOD" Margin="0,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Paste a Kick VOD link (kick.com/channel/videos/…) or its UUID."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="VOD link or UUID"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AutomationProperties.Name="VOD link or UUID" KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" Content="Get Info" Margin="8,0,0,0" MinWidth="88" Click="Info_Click"/>
            </Grid>

            <Border x:Name="InfoCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <TextBlock x:Name="InfoText" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Quality"/>
            <ComboBox x:Name="QualityBox" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Label"
                      AutomationProperties.Name="Quality"/>
            <TextBlock Style="{StaticResource Hint}" Text="Qualities are loaded by 'Get Info'. If you pick none, the highest quality is downloaded."/>

            <CheckBox x:Name="TrimBox" Content="Download only a time range" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=TrimBox}">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Start (hh:mm:ss)"/>
                    <TextBox x:Name="StartBox" Width="150" Text="00:00:00" AutomationProperties.Name="Start time"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="End (hh:mm:ss)"/>
                    <TextBox x:Name="EndBox" Width="150" Text="00:00:30" AutomationProperties.Name="End time"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The range is cut without re-encoding, so the start may land a few seconds early."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
            <views:FolderField/>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="8,0,24,12" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="FormError" Style="{StaticResource ErrorText}"/>
        <Button Margin="0,8,0,0" x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="Download" Click="Download_Click"/>
    </StackPanel>
</Grid>
</UserControl>
