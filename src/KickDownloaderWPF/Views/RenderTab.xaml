<UserControl x:Class="KickDownloaderWPF.Views.RenderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KickDownloaderWPF.Views"
             IsEnabled="{Binding NotBusy}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,24,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Render chat" Margin="0,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Creates a transparent (alpha channel) chat video from a downloaded chat .json file. Overlay it on your video with a video editor or ffmpeg."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Chat file (.json)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AutomationProperties.Name="Chat json file"/>
                <Button Grid.Column="1" Content="Choose file…" Margin="8,0,0,0" MinWidth="104" Click="BrowseInput_Click"/>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Output format"/>
            <ComboBox x:Name="FormatBox" Width="340" HorizontalAlignment="Left" DisplayMemberPath="Label"
                      AutomationProperties.Name="Output format"/>
            <TextBlock x:Name="FormatHint" Style="{StaticResource Hint}"/>

            <UniformGrid Columns="3" Margin="0,4,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width (px)"/>
                    <TextBox x:Name="WidthBox" Text="350" AutomationProperties.Name="Width"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Height (px)"/>
                    <TextBox x:Name="HeightBox" Text="600" AutomationProperties.Name="Height"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FPS"/>
                    <TextBox x:Name="FpsBox" Text="30" AutomationProperties.Name="Frames per second"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Font size"/>
                    <TextBox x:Name="FontBox" Text="12" AutomationProperties.Name="Font size"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Emote scale"/>
                    <TextBox x:Name="EmoteBox" Text="1.0" AutomationProperties.Name="Emote scale"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Background color"/>
                    <TextBox x:Name="BackgroundBox" Text="#00000000" AutomationProperties.Name="Background color"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Background: #AARRGGBB. Use #00000000 for transparency. Width and height must be even numbers (100–8192)."/>

            <CheckBox x:Name="TimestampBox" Content="Show a timestamp next to each message" Margin="0,16,0,0"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
            <views:FolderField/>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="8,0,24,12" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="FormError" Style="{StaticResource ErrorText}"/>
        <Button Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Content="Render" Click="Render_Click"/>
    </StackPanel>
</Grid>
</UserControl>
