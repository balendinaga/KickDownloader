<UserControl x:Class="KickDownloaderWPF.Views.ChatTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KickDownloaderWPF.Views"
             IsEnabled="{Binding NotBusy}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,24,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Download chat" Margin="0,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Downloads the VOD's chat history as a .json file that the renderer can use. Emote and badge images are embedded in the file."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="VOD link or UUID"/>
            <TextBox x:Name="InputBox" AutomationProperties.Name="VOD link or UUID"/>

            <CheckBox x:Name="TrimBox" Content="Download only a time range" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=TrimBox}">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Start (hh:mm:ss)"/>
                    <TextBox x:Name="StartBox" Width="150" Text="00:00:00" AutomationProperties.Name="Start time"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="End (hh:mm:ss)"/>
                    <TextBox x:Name="EndBox" Width="150" Text="00:05:00" AutomationProperties.Name="End time"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Times count from the start of the VOD. If you leave the box unchecked, the whole chat is downloaded, which can take a long time for multi-hour VODs."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
            <views:FolderField/>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="8,0,24,12" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="FormError" Style="{StaticResource ErrorText}"/>
        <Button Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Content="Download Chat" Click="Download_Click"/>
    </StackPanel>
</Grid>
</UserControl>
