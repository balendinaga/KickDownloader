<UserControl x:Class="KickDownloaderWPF.Views.ClipTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KickDownloaderWPF.Views"
             IsEnabled="{Binding NotBusy}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,24,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Download clip" Margin="0,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Paste a Kick clip link (kick.com/channel/clips/clip_…) or the clip id."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Clip link or id"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AutomationProperties.Name="Clip link or id" KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" Content="Get Info" Margin="8,0,0,0" MinWidth="88" Click="Info_Click"/>
            </Grid>

            <Border x:Name="InfoCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap"/>
                    <Button x:Name="TransferButton" Content="Send to Download Chat tab" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Click="Transfer_Click"/>
                    <TextBlock x:Name="TransferHint" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
            <views:FolderField/>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="8,0,24,12" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock x:Name="FormError" Style="{StaticResource ErrorText}"/>
        <Button Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" Content="Download" Click="Download_Click"/>
    </StackPanel>
</Grid>
</UserControl>
