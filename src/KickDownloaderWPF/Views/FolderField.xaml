<UserControl x:Class="KickDownloaderWPF.Views.FolderField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KickDownloaderWPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox"
                 AutomationProperties.Name="Output folder"
                 Text="{Binding OutputFolder, Source={x:Static local:AppSettings.Current}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" MinWidth="88" Click="Browse_Click"
                AutomationProperties.Name="Choose output folder"/>
    </Grid>
</UserControl>
